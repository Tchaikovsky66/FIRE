{
  "name": "fire-planner",
  "version": "1.0.0",
  "type": "module",
  "description": "一个通过引导式输入和实时图形，帮助个人或家庭理解提前退休资金与时间需求的网页小程序。",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "test": "vitest run --config vite.config.ts",
    "dev": "vite --config vite.config.ts",
    "build": "tsc -b && vite build --config vite.config.ts",
    "build:pages": "tsc -b && vite build --config vite.config.ts --base=/FIRE/",
    "preview": "vite preview",
    "test:e2e": "playwright test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "clsx": "^2.1.1",
    "figma-squircle": "^1.1.0",
    "flubber": "^0.4.2",
    "html-to-image": "^1.11.13",
    "motion": "^14.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-use-measure": "^2.1.7",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/flubber": "^0.4.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
